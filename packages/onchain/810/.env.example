# FastAPI Backend URL (Point this to your 810-execution-engine Cloud Run URL in production)
# Example: "https://810-execution-engine-xxxxx.run.app"
NEXT_PUBLIC_API_BASE_URL="http://localhost:3000"

# Supabase Auth / DB (Direct URL)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Server-side Service Role (Optional, for admin bypass)
SUPABASE_SERVICE_ROLE_KEY=

# Privy Authentication
NEXT_PUBLIC_PRIVY_APP_ID=

# HyperEVM / Hyperliquid
# Web3 Provider URL and contract addresses
NEXT_PUBLIC_RPC_URL="https://hyperliquid-rpc.example.com"
NEXT_PUBLIC_CONTRACT_ADDRESS=

# Vertex AI / LLM Integration
GCP_PROJECT_ID=
GCP_LOCATION=
GOOGLE_APPLICATION_CREDENTIALS=
